{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.local.md"
  ],
  "model": "9router/9routerDsV4",
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "apiKey": "{env:API_KEY_9ROUTER}"
      },
      "models": {
        "9routerCodexTerra": {
          "name": "9routerCodexTerra",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "9routerAntiGravityGemimi38": {
          "name": "9routerAntiGravityGemimi38",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "9routerDsV4": {
          "name": "9routerDsV4",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
